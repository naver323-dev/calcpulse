---
/**
 * The SaaS break-even / ROI calculator block, shared by every guide that needs it.
 *
 * The markup and the wiring are the original page code moved here unchanged so the
 * daily pipeline can render the same calculator on a generated guide. The script
 * bundles per page that imports this component; ids stay the ones
 * scripts/test_dom.mjs drives.
 */
---

      <section
        class="mt-10 rounded-2xl border border-ink-200 bg-white p-5 sm:p-7 shadow-sm"
        aria-labelledby="calc-heading"
      >
        <h2 id="calc-heading" class="text-lg font-semibold text-ink-950">SaaS break-even calculator</h2>
        <p class="mt-1 text-sm text-ink-600">
          All figures in one currency. Nothing is sent anywhere; the maths runs on this page.
        </p>

        <form id="roi-form" class="mt-6 grid gap-4 sm:grid-cols-2" novalidate>
          <div class="calc-field">
            <label for="seats" class="block text-sm font-medium text-ink-800">Paid seats</label>
            <input id="seats" type="number" min="1" step="1" value="10" inputmode="numeric" />
          </div>
          <div class="calc-field">
            <label for="price" class="block text-sm font-medium text-ink-800">Price per seat, per month</label>
            <input id="price" type="number" min="0" step="0.01" value="25" inputmode="decimal" />
          </div>
          <div class="calc-field">
            <label for="setup" class="block text-sm font-medium text-ink-800">
              One-off cost (setup, migration, training)
            </label>
            <input id="setup" type="number" min="0" step="1" value="1500" inputmode="numeric" />
          </div>
          <div class="calc-field">
            <label for="hours" class="block text-sm font-medium text-ink-800">
              Hours saved per used seat, per month
            </label>
            <input id="hours" type="number" min="0" step="0.1" value="4" inputmode="decimal" />
          </div>
          <div class="calc-field">
            <label for="rate" class="block text-sm font-medium text-ink-800">Loaded hourly rate</label>
            <input id="rate" type="number" min="0" step="1" value="40" inputmode="numeric" />
          </div>
          <div class="calc-field">
            <label for="adoption" class="block text-sm font-medium text-ink-800">
              Weekly adoption <span class="text-ink-400">(% of paid seats)</span>
            </label>
            <input id="adoption" type="number" min="0" max="100" step="1" value="70" inputmode="numeric" />
          </div>
        </form>

        <noscript>
          <p class="mt-6 rounded-lg bg-ink-100 px-4 py-3 text-sm text-ink-800">
            This calculator does the arithmetic in your browser, so it needs JavaScript. The formula is
            written out in the guide above if you would rather do it by hand.
          </p>
        </noscript>

        <div class="mt-7 grid gap-4 sm:grid-cols-3" aria-live="polite">
          <div class="result-card rounded-xl bg-ink-950 p-5 text-white">
            <p class="text-xs uppercase tracking-wider text-ink-400">Payback</p>
            <p id="out-payback" class="mt-2 text-3xl font-semibold">—</p>
            <p id="out-payback-note" class="mt-1 text-xs text-ink-400">months to recover all cash</p>
          </div>
          <div class="result-card rounded-xl border border-ink-200 p-5">
            <p class="text-xs uppercase tracking-wider text-ink-400">Net per month</p>
            <p id="out-net" class="mt-2 text-3xl font-semibold text-ink-950">—</p>
            <p id="out-monthly-cost" class="mt-1 text-xs text-ink-400">subscription: —</p>
          </div>
          <div class="result-card rounded-xl border border-ink-200 p-5">
            <p class="text-xs uppercase tracking-wider text-ink-400">12-month ROI</p>
            <p id="out-roi" class="mt-2 text-3xl font-semibold text-ink-950">—</p>
            <p id="out-year" class="mt-1 text-xs text-ink-400">—</p>
          </div>
        </div>

        <div class="mt-6 overflow-x-auto">
          <table class="w-full text-sm">
            <caption class="sr-only">Twelve-month cash view</caption>
            <thead>
              <tr class="text-left text-xs uppercase tracking-wider text-ink-400">
                <th scope="col" class="py-2 pr-4 font-medium">Line</th>
                <th scope="col" class="py-2 font-medium text-right">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-ink-100 text-ink-800">
              <tr>
                <th scope="row" class="py-2 pr-4 text-left font-normal">Value actually used (12 months)</th>
                <td id="row-value" class="py-2 text-right tabular-nums">—</td>
              </tr>
              <tr>
                <th scope="row" class="py-2 pr-4 text-left font-normal">Subscriptions (12 months)</th>
                <td id="row-subs" class="py-2 text-right tabular-nums">—</td>
              </tr>
              <tr>
                <th scope="row" class="py-2 pr-4 text-left font-normal">One-off cost</th>
                <td id="row-setup" class="py-2 text-right tabular-nums">—</td>
              </tr>
              <tr>
                <th scope="row" class="py-2 pr-4 text-left font-normal">Net after 12 months</th>
                <td id="row-net12" class="py-2 text-right tabular-nums font-medium">—</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p id="verdict" class="mt-4 rounded-lg bg-ink-50 px-4 py-3 text-sm text-ink-700">—</p>
      </section>

<script>
  import { computeSaasRoi } from '../lib/calculations';

  const form = document.getElementById('roi-form') as HTMLFormElement | null;

  if (form) {
    const ids = ['seats', 'price', 'setup', 'hours', 'rate', 'adoption'] as const;
    type Id = (typeof ids)[number];

    const el = (id: Id) => document.getElementById(id) as HTMLInputElement | null;
    const out = (id: string) => document.getElementById(id) as HTMLElement | null;

    const num = (id: Id, fallback = 0): number => {
      const node = el(id);
      if (!node) return fallback;
      const value = Number.parseFloat(node.value);
      return Number.isFinite(value) && value >= 0 ? value : fallback;
    };

    const money = (value: number): string =>
      Math.round(value).toLocaleString('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: 0,
      });

    const compute = () => {
      const result = computeSaasRoi({
        seats: num('seats', 1),
        pricePerSeat: num('price'),
        oneOffCost: num('setup'),
        hoursSavedPerSeat: num('hours'),
        hourlyRate: num('rate'),
        adoptionRate: num('adoption') / 100,
      });

      const set = (id: string, text: string) => {
        const node = out(id);
        if (node) node.textContent = text;
      };

      if (result.paybackMonths === null) {
        set('out-payback', 'Never');
      } else if (result.paybackMonths < 0.1) {
        set('out-payback', 'Immediate');
      } else {
        set('out-payback', `${result.paybackMonths.toFixed(1)} mo`);
      }

      set(
        'out-payback-note',
        result.breakEvenUsedSeats === null
          ? 'no saving entered, so nothing breaks even'
          : `break-even at ${result.breakEvenUsedSeats.toFixed(1)} actively used seats`,
      );
      set('out-net', money(result.netMonthly));
      set('out-monthly-cost', `subscription: ${money(result.monthlySubscription)}/mo`);
      set(
        'out-roi',
        result.roiPercent === null
          ? '—'
          : `${result.roiPercent >= 0 ? '+' : ''}${result.roiPercent.toFixed(0)}%`,
      );
      set('out-year', `net ${money(result.net12)} after 12 months`);

      set('row-value', money(result.value12));
      set('row-subs', money(result.subscriptions12));
      set('row-setup', money(num('setup')));
      set('row-net12', money(result.net12));

      const verdict = out('verdict');
      if (verdict) {
        const adoptionLabel = Math.round(Math.min(100, num('adoption')));
        let text: string;
        if (result.netMonthly <= 0) {
          text =
            'At this adoption and saving, the subscription costs more per month than the time it returns. The price, the seat count or the claimed saving has to change before the deal works.';
        } else if (result.net12 <= 0) {
          text =
            'The monthly line is positive, but the one-off cost is still unpaid after a year. That is a bet on year two — only take it on a contract you can leave.';
        } else {
          text = `The tool clears its one-off cost in ${(result.paybackMonths ?? 0).toFixed(1)} months and is ${money(result.net12)} ahead after a year, assuming ${adoptionLabel}% of seats use it weekly and an hour saved is worth ${money(num('rate'))}.`;
        }
        verdict.textContent = text;
      }
    };

    form.addEventListener('input', compute);
    form.addEventListener('submit', (event) => event.preventDefault());
    compute();
  }
</script>
