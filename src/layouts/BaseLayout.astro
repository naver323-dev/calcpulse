---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Optional JSON-LD graph nodes supplied by the page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  updated?: string;
}

const { title, description, jsonLd, updated } = Astro.props;

const site = Astro.site ?? new URL('https://calcpulse.pages.dev');
const origin = site.origin;
const canonical = new URL(Astro.url.pathname, site).href;

const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#organization`,
      name: 'CalcPulse',
      url: `${origin}/`,
      description:
        'CalcPulse publishes practical, source-checked guides for AI, automation and small-business finance, each with a working calculator on the same page.',
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      url: `${origin}/`,
      name: 'CalcPulse',
      description,
      inLanguage: 'en',
      publisher: { '@id': `${origin}/#organization` },
    },
  ],
};

const graphs = [siteGraph, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="theme-color" content="#0d1117" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CalcPulse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {
      graphs.map((graph) => (
        <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
      ))
    }

    <!--
      No advertising network and no third-party scripts are loaded on this site.
      Monetisation is affiliate/partner links and traffic to P2 (Gumroad) only, so the
      first paint stays free of external requests. See src/data/monetization.ts.
    -->
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-ink-200 bg-white/80 backdrop-blur sticky top-0 z-10">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 flex items-center justify-between h-14">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-ink-950">
          <span
            class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-pulse-500 text-white text-sm font-bold"
            aria-hidden="true">CP</span
          >
          CalcPulse
        </a>
        <nav class="flex items-center gap-4 text-sm text-ink-600" aria-label="Main">
          <a href="/guides/" class="hover:text-ink-950">Guides</a>
          <a href="/vault/" class="hover:text-ink-950">Vault</a>
          <a href="/about/" class="hover:text-ink-950">About</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-ink-200 bg-white mt-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 py-8 text-sm text-ink-600">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <p>
            &copy; {new Date().getFullYear()} CalcPulse. Guides are written for practitioners; every
            calculator runs locally in your browser.
          </p>
          <nav class="flex flex-wrap gap-4" aria-label="Footer">
            <a href="/guides/" class="hover:text-ink-950">Guides</a>
            <a href="/vault/" class="hover:text-ink-950">Vault</a>
            <a href="/about/" class="hover:text-ink-950">About</a>
            <a href="/affiliate-disclosure/" class="hover:text-ink-950">Disclosure</a>
            <a href="/privacy/" class="hover:text-ink-950">Privacy</a>
            <a href="/llms.txt" class="hover:text-ink-950">llms.txt</a>
          </nav>
        </div>
        {updated && <p class="mt-3 text-ink-400">Last reviewed {updated}</p>}
      </div>
    </footer>
  </body>
</html>
