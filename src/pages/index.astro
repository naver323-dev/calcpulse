---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guides } from '../data/guides';
import OfferSlot from '../components/OfferSlot.astro';

const description =
  'Source-checked guides for AI, automation and small-business finance, each with a working calculator on the same page. No sign-up, no email gate, all maths in your browser.';
---

<BaseLayout title="CalcPulse — Guides with the calculator built in" description={description}>
  <section class="border-b border-ink-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 py-14 sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-pulse-600">
        Guides with the calculator built in
      </p>
      <h1 class="mt-3 text-3xl sm:text-5xl font-semibold tracking-tight text-ink-950 max-w-3xl">
        Decisions that hinge on a number deserve to show the number.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-600 leading-relaxed">
        Most “pricing” articles tell you what to feel. CalcPulse writes the working out: the inputs
        that actually move the answer, a calculator you can put your own numbers into, and the
        assumptions spelled out so you can disagree with them.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/guides/"
          class="inline-flex items-center rounded-lg bg-pulse-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-pulse-700"
          >Browse the guides</a
        >
        <a
          href="/about/"
          class="inline-flex items-center rounded-lg border border-ink-200 bg-white px-4 py-2.5 text-sm font-semibold text-ink-800 hover:border-ink-400"
          >How the numbers are checked</a
        >
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-14">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-xl font-semibold text-ink-950">Live calculators</h2>
      <a href="/guides/" class="text-sm text-pulse-600 hover:text-pulse-700">All guides →</a>
    </div>

    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {
        guides.map((guide) => (
          <article class="flex flex-col rounded-xl border border-ink-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">{guide.topic}</p>
            <h3 class="mt-2 text-lg font-semibold leading-snug text-ink-950">
              <a href={`/guides/${guide.slug}/`} class="hover:text-pulse-700">
                {guide.h1}
              </a>
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{guide.description}</p>
            <p class="mt-4 text-xs text-ink-400">
              {guide.calculator} · {guide.minutes} min read · reviewed {guide.updated}
            </p>
            <a
              href={`/guides/${guide.slug}/`}
              class="mt-4 inline-flex text-sm font-semibold text-pulse-600 hover:text-pulse-700"
            >
              Open the calculator →
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-white border-y border-ink-200">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 py-14 grid gap-8 sm:grid-cols-3">
      <div>
        <h2 class="text-sm font-semibold text-ink-950">Every calculator is local</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">
          The maths runs in your browser. Nothing you type is sent to a server, stored, or attached to
          an account.
        </p>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-ink-950">Rates are yours to set</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">
          Price tables change without notice, so the calculators take your own figures instead of
          baking in a number that is wrong by the time you read it.
        </p>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-ink-950">Assumptions are visible</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">
          Each guide states what it ignores. A number you cannot audit is a number you should not
          budget against.
        </p>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-14 grid gap-8 sm:grid-cols-5">
    <div class="sm:col-span-3">
      <h2 class="text-xl font-semibold text-ink-950">How this site makes money</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-600">
        No advertising network and no tracking beyond an aggregate pageview count. Guides are free to
        read and cost nothing to use, and the calculators never ask for an account. If a guide links to a paid product, the link
        is either to something built here — the workflow vault — or to a partner that pays a commission.
        Both are labelled where they appear.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-ink-600">
        That is the whole model: useful pages that earn their traffic, and a small number of honest
        links at the bottom of them. Read the
        <a href="/affiliate-disclosure/" class="text-pulse-600 hover:text-pulse-700">disclosure</a>
        for the detail.
      </p>
    </div>
    <div class="sm:col-span-2">
      <OfferSlot ids={['vault', 'stackverdict']} />
    </div>
  </section>

</BaseLayout>
