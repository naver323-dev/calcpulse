---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides } from '../../data/guides';
import VaultCallout from '../../components/VaultCallout.astro';

const description =
  'Every CalcPulse guide, grouped by topic. Each page carries a working calculator, its assumptions and the sources behind the figures.';
---

<BaseLayout title="Guides — CalcPulse" description={description}>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-12">
    <nav class="text-sm text-ink-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink-600">Home</a> <span aria-hidden="true">/</span> Guides
    </nav>
    <h1 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-ink-950">Guides</h1>
    <p class="mt-3 max-w-2xl text-ink-600">
      Long-form workings, not listicles. Each guide pairs an argument with a calculator so you can
      test the argument against your own figures.
    </p>

    <ul class="mt-10 divide-y divide-ink-200 border-y border-ink-200">
      {
        guides.map((guide) => (
          <li class="py-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-pulse-600">{guide.topic}</p>
            <h2 class="mt-1 text-xl font-semibold text-ink-950">
              <a href={`/guides/${guide.slug}/`} class="hover:text-pulse-700">
                {guide.h1}
              </a>
            </h2>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-600">{guide.description}</p>
            <p class="mt-3 text-xs text-ink-400">
              {guide.calculator} · {guide.minutes} min · reviewed {guide.updated}
            </p>
          </li>
        ))
      }
    </ul>

    <VaultCallout class="mt-12" />
  </div>
</BaseLayout>
