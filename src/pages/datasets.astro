---
import BaseLayout from '../layouts/BaseLayout.astro';
import sample from '../data/dataset-sample.json';

const description =
  'A free weekly sample of CalcPulse Open-Data Weekly: 14 public macro and AI-ecosystem series with the week-over-week change, a 12-period z-score and an outlier flag.';

// The Gumroad listing URL arrives through the build environment (P2 uses
// PUBLIC_GUMROAD_VAULT_URL for the same reason). While it is empty the page renders
// the free sample only — the site never ships a dead "buy" link.
const listingUrl =
  import.meta.env.PUBLIC_GUMROAD_DATASET_URL ?? import.meta.env.PUBLIC_DATASET_URL ?? '';
const sampleFile = `/datasets/calcpulse-open-data-sample-${sample.week}.csv`;

const fmt = (value: number | null, unit: string): string => {
  if (value === null || value === undefined) return '—';
  if (unit.startsWith('repositories')) return Math.round(value).toLocaleString('en-US');
  const digits = Math.abs(value) >= 100 ? 2 : Math.abs(value) >= 10 ? 2 : 3;
  return value.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });
};

const fmtPct = (value: number | null): string => {
  if (value === null || value === undefined) return '—';
  return `${value > 0 ? '+' : ''}${value.toFixed(2)}%`;
};

const seriesList = [
  ['Rates', 'US effective federal funds rate', '% p.a.'],
  ['Rates', 'US 10-year Treasury yield', '% p.a.'],
  ['Inflation', 'US CPI, all urban consumers (SA)', 'index, 1982-84 = 100'],
  ['FX', 'USD/KRW · EUR/KRW · JPY/KRW · CNY/KRW · EUR/USD · USD/JPY', 'daily cross rates'],
  ['Equity', 'Nasdaq Composite', 'index points'],
  ['Risk', 'CBOE volatility index (VIX)', 'index points'],
  ['AI ecosystem', 'New repositories tagged topic:llm · topic:ai-agents · topic:mcp', 'repos / week'],
];

const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `CalcPulse Open-Data Weekly — ${sample.week}`,
  description:
    'Weekly cleaned readings of US rates, inflation, FX, equity and volatility series plus GitHub AI-ecosystem repository counts, with week-over-week change, a 12-period z-score and an outlier flag.',
  creator: { '@type': 'Organization', name: 'CalcPulse Editorial Team' },
  isAccessibleForFree: false,
  dateModified: sample.fetchedAt,
  temporalCoverage: '2025/2026',
  keywords: ['macro data', 'open data', 'CSV', 'week-over-week change', 'AI ecosystem'],
  variableMeasured: sample.rows.map((row) => row.label),
  distribution: [
    {
      '@type': 'DataDownload',
      name: 'Free six-series sample (CSV)',
      encodingFormat: 'text/csv',
      contentUrl: new URL(sampleFile, Astro.site ?? 'https://calcpulse.pages.dev').href,
    },
  ],
};
---

<BaseLayout
  title="Open data, cleaned weekly — CalcPulse Datasets"
  description={description}
  jsonLd={datasetLd}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-12">
    <nav class="text-sm text-ink-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink-600">Home</a> <span aria-hidden="true">/</span> Datasets
    </nav>

    <h1 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-ink-950">
      Open data, cleaned weekly
    </h1>
    <p class="mt-3 max-w-2xl text-ink-600">
      Fourteen public macro and AI-ecosystem series, rebuilt every Monday with the week-over-week
      change, a 12-period z-score and an outlier flag already computed. The six-series sample below
      is free; the full pack is a $9 file with the whole table, twelve months of weekly history and
      the written briefing.
    </p>

    <section class="mt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-xl font-semibold text-ink-950">This week&rsquo;s sample — {sample.week}</h2>
        <p class="text-xs text-ink-400">
          {sample.sampleSeries} of {sample.totalSeries} series · snapshot {sample.fetchedAt}
        </p>
      </div>

      <div class="mt-4 overflow-x-auto rounded-xl border border-ink-200 bg-white">
        <table class="w-full text-sm">
          <thead class="bg-ink-50 text-left text-xs uppercase tracking-wider text-ink-500">
            <tr>
              <th class="px-4 py-3 font-semibold">Metric (unit)</th>
              <th class="px-4 py-3 font-semibold text-right">Latest</th>
              <th class="px-4 py-3 font-semibold text-right">Prev (7d)</th>
              <th class="px-4 py-3 font-semibold text-right">Change</th>
              <th class="px-4 py-3 font-semibold text-right">z (12w)</th>
              <th class="px-4 py-3 font-semibold">Flag</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-100">
            {sample.rows.map((row) => (
              <tr>
                <td class="px-4 py-3">
                  <span class="font-medium text-ink-950">{row.label}</span>
                  <span class="block text-xs text-ink-400">{row.unit} · observation {row.latestDate}</span>
                </td>
                <td class="px-4 py-3 text-right tabular-nums text-ink-950">{fmt(row.latest, row.unit)}</td>
                <td class="px-4 py-3 text-right tabular-nums text-ink-600">{fmt(row.prev, row.unit)}</td>
                <td class="px-4 py-3 text-right tabular-nums text-ink-950">{fmtPct(row.changePct)}</td>
                <td class="px-4 py-3 text-right tabular-nums text-ink-600">
                  {row.zScore === null ? '—' : `${row.zScore > 0 ? '+' : ''}${row.zScore.toFixed(2)}`}
                </td>
                <td class="px-4 py-3">
                  {row.isOutlier ? (
                    <span class="rounded-full bg-pulse-50 px-2 py-0.5 text-xs font-semibold text-pulse-700">
                      outlier
                    </span>
                  ) : (
                    <span class="text-xs text-ink-400">—</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="mt-3 text-sm text-ink-600">
        The sample is a real slice of this week&rsquo;s build, not a mock-up — the same twenty
        columns, six rows shorter.{' '}
        <a href={sampleFile} class="font-medium text-pulse-700 hover:text-pulse-800" download>
          Download the sample CSV
        </a>
        .
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-ink-950">What the full pack holds</h2>
      <p class="mt-2 max-w-3xl text-ink-600">
        One file per week, same listing, same price. Every row keeps the public page it came from,
        so any figure can be traced back to its origin in one click.
      </p>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-ink-200 bg-white p-5">
          <p class="text-sm font-semibold text-ink-950">weekly-macro-tech-diff-{'{week}'}.csv</p>
          <p class="mt-1 text-sm text-ink-600">
            {sample.totalSeries} rows × 20 columns: latest value, previous value, the exact dates both
            came from, absolute and percent change, a 4-week change, a 12-period z-score and an
            outlier flag.
          </p>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-5">
          <p class="text-sm font-semibold text-ink-950">weekly-macro-tech-series-latest.csv</p>
          <p class="mt-1 text-sm text-ink-600">
            The same series as tidy weekly history — long format, up to 52 periods, with the forming
            week marked partial so a chart does not compare half a week to a full one.
          </p>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-5">
          <p class="text-sm font-semibold text-ink-950">briefing-{'{week}'}.md</p>
          <p class="mt-1 text-sm text-ink-600">
            The written read: largest moves with the two values they were computed from, outliers,
            what did not move, and the method.
          </p>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-5">
          <p class="text-sm font-semibold text-ink-950">DATASET-README.md + LICENSE.txt</p>
          <p class="mt-1 text-sm text-ink-600">
            Column dictionary, refresh rules and terms. Use it inside your organisation; do not
            resell the pack itself.
          </p>
        </div>
      </div>

      <div class="mt-8 overflow-x-auto rounded-xl border border-ink-200 bg-white">
        <table class="w-full text-sm">
          <thead class="bg-ink-50 text-left text-xs uppercase tracking-wider text-ink-500">
            <tr>
              <th class="px-4 py-3 font-semibold">Category</th>
              <th class="px-4 py-3 font-semibold">Series</th>
              <th class="px-4 py-3 font-semibold">Unit</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-100">
            {seriesList.map(([category, series, unit]) => (
              <tr>
                <td class="px-4 py-3 text-ink-600">{category}</td>
                <td class="px-4 py-3 text-ink-950">{series}</td>
                <td class="px-4 py-3 text-ink-600">{unit}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12 rounded-xl border border-ink-200 bg-white p-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">The full pack</p>
      <h2 class="mt-1 text-xl font-semibold text-ink-950">$9, one week&rsquo;s pack, no subscription</h2>
      <p class="mt-2 max-w-2xl text-sm text-ink-600">
        A new pack is built every Monday and replaces the file on the same listing. You get the CSV,
        the weekly history and the briefing; nothing else on this site is gated.
      </p>
      {listingUrl ? (
        <a
          href={listingUrl}
          class="mt-4 inline-flex items-center rounded-md bg-pulse-600 px-4 py-2 text-sm font-semibold text-white hover:bg-pulse-700"
          rel="noopener"
        >
          Get this week&rsquo;s pack →
        </a>
      ) : (
        <p class="mt-4 text-sm text-ink-500">
          The Gumroad listing opens with the first shipped pack. Until then this page, the sample CSV
          and the{' '}
          <a href="/guides/" class="underline decoration-ink-300 underline-offset-2 hover:text-ink-950">
            guides
          </a>{' '}
          are the whole offer.
        </p>
      )}
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-ink-950">How the numbers are made</h2>
      <div class="mt-3 max-w-3xl space-y-3 text-sm leading-relaxed text-ink-600">
        <p>
          <strong class="text-ink-950">Sources.</strong> FRED, the Federal Reserve Bank of St. Louis
          download endpoint; the ECB euro reference rates retrieved through Frankfurter; and GitHub&rsquo;s
          public search counts of repositories created each week. All free, all without an API key,
          so the pack costs nothing to produce and nothing to keep running.
        </p>
        <p>
          <strong class="text-ink-950">Comparison.</strong> Daily series compare the latest print with
          the last print on or before the seven-day mark, and the actual gap is a column
          (<code class="text-xs">window_days</code>) — a holiday should not silently empty a row.
          Monthly series compare month over month. Weekly counts use rolling seven-day windows.
        </p>
        <p>
          <strong class="text-ink-950">Outliers.</strong> The latest change is scored against the
          previous twelve changes of the same series, so a 0.2% move in VIX and a 0.2% move in a repo
          count are not treated as the same event. Below three prior changes the z-score is blank and
          the flag is FALSE rather than guessed.
        </p>
        <p>
          <strong class="text-ink-950">The guard.</strong> If any series comes back empty — a changed
          schema, a blocked request, an empty body — the build exits non-zero and publishes nothing.
          The previous week&rsquo;s pack stays the current one. A header-only CSV is never sold here.
        </p>
        <p>
          <strong class="text-ink-950">What it is not.</strong> No forecast, no advice, no
          &ldquo;intelligence&rdquo;. GitHub totals are raw search counts and include bulk uploads and
          duplicates, which the briefing says out loud rather than hiding.
        </p>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-ink-950">Where the numbers are used</h2>
      <p class="mt-2 max-w-3xl text-sm text-ink-600">
        The same figures drive the calculators: an exchange-rate move changes what an overseas API
        bill costs in won, and a rate move changes what a break-even month looks like.
      </p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href="/guides/ai-api-cost-calculator/" class="font-medium text-pulse-700 hover:text-pulse-800">
            LLM API cost calculator
          </a>
          <span class="text-ink-600"> — what a monthly token bill actually comes to, and what a rate move does to it.</span>
        </li>
        <li>
          <a href="/guides/saas-break-even-calculator/" class="font-medium text-pulse-700 hover:text-pulse-800">
            SaaS break-even calculator
          </a>
          <span class="text-ink-600"> — the month a paid tool starts paying for itself.</span>
        </li>
        <li>
          <a href="/guides/payment-fee-calculator/" class="font-medium text-pulse-700 hover:text-pulse-800">
            Payment fee calculator
          </a>
          <span class="text-ink-600"> — the fee stack between a sale and the money that arrives.</span>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
