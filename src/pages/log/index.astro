---
/**
 * /log/ — the build log index.
 *
 * Not a blog and not a changelog: the entries here are operations records for the
 * site itself, in one fixed shape (Constraint → What broke → Numbers → Next test).
 * The badges are computed at build time from the same data the pages render, so a
 * badge cannot drift from the thing it counts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides } from '../../data/guides';
import { automatedChecks, infraCostUsd, latestFirst } from '../../data/buildlog';

const entries = latestFirst();
const calculatorCount = new Set(guides.map((guide) => guide.calculator)).size;

const description =
  'The operating record behind CalcPulse: what the $0 constraint rules out, what broke, the numbers behind each publish, and the next test.';

const badges = [
  { label: 'Calculators', value: String(calculatorCount), note: 'all browser-side' },
  { label: 'Automated checks', value: `${automatedChecks}/${automatedChecks}`, note: 'gating every publish' },
  { label: 'Infra cost', value: `$${infraCostUsd.toFixed(2)}/mo`, note: 'free tiers only' },
];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'CalcPulse build log',
    description,
    inLanguage: 'en',
    url: new URL('/log/', Astro.site ?? 'https://calcpulse.pages.dev').href,
    blogPost: entries.map((entry) => ({
      '@type': 'TechArticle',
      headline: entry.title,
      url: new URL(`/log/${entry.slug}/`, Astro.site ?? 'https://calcpulse.pages.dev').href,
      datePublished: entry.published,
      dateModified: entry.updated,
    })),
  },
];
---

<BaseLayout title="Build log — CalcPulse" description={description} jsonLd={jsonLd}>
  <section class="border-b border-ink-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 py-12 sm:py-16">
      <nav class="text-sm text-ink-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-ink-600">Home</a> <span aria-hidden="true">/</span> Build log
      </nav>

      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-pulse-600">
        Operating record
      </p>
      <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-ink-950 sm:text-5xl">
        The log behind the calculators
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-600">
        Every guide on this site makes a claim about a number. This is where the claims about the
        site itself go: what the zero-cost constraint rules out, what broke anyway, the figures
        behind each publish, and the one test that comes next. Entries are written from collected
        logs twice a week, not daily.
      </p>

      <dl class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          badges.map((badge) => (
            <div class="rounded-xl border border-ink-200 bg-ink-50/60 px-4 py-3">
              <dt class="text-xs font-semibold uppercase tracking-wider text-ink-400">
                {badge.label}
              </dt>
              <dd class="mt-1 text-2xl font-semibold text-ink-950">{badge.value}</dd>
              <dd class="mt-0.5 text-xs text-ink-400">{badge.note}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12 sm:py-14">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-400">Entries</h2>

    <ol class="mt-4 divide-y divide-ink-200 border-y border-ink-200">
      {
        entries.map((entry) => (
          <li class="py-6">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="text-xs font-semibold uppercase tracking-wider text-pulse-600">
                Day {entry.day}
              </span>
              <span class="text-xs text-ink-400">{entry.published}</span>
              <span class="text-xs text-ink-400">· {entry.minutes} min</span>
            </div>
            <h3 class="mt-1.5 text-xl font-semibold leading-snug text-ink-950">
              <a href={`/log/${entry.slug}/`} class="hover:text-pulse-700">
                {entry.title}
              </a>
            </h3>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-600">{entry.summary}</p>
            <p class="mt-3 text-xs text-ink-400">
              {entry.numbers.length} measured figures · {entry.failures.length} things that broke ·{' '}
              <a href={`/log/${entry.slug}/`} class="font-semibold text-pulse-600 hover:text-pulse-700">
                Read the entry →
              </a>
            </p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-ink-200 bg-white p-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">Why this exists</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">
          A calculator is a claim that the arithmetic is right and the assumptions are stated. The
          log is the same claim about the site: the checks that gate a publish, the pages that must
          exist, and the topics a build refuses to ship.
        </p>
      </div>
      <div class="rounded-xl border border-ink-200 bg-white p-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">How it is measured</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">
          Four events only — a log view, a click from a log to a calculator, a click to a paid
          listing with the product attached, and a view of the free samples. Anything that cannot be
          counted is written as "not measured" rather than estimated.
        </p>
      </div>
    </div>

    <p class="mt-10 text-sm text-ink-600">
      Prefer the numbers with a calculator attached?
      <a href="/guides/" class="font-semibold text-pulse-600 hover:text-pulse-700">
        Browse the guides →
      </a>
    </p>
  </section>
</BaseLayout>

<script is:inline define:vars={{ logId: 'index' }}>
  if (typeof window.gtag === 'function') {
    window.gtag('event', 'log_view', { log_id: logId, day: 0 });
  }
</script>
