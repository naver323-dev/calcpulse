{
  "name": "calcpulse",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "guard": "python3 scripts/forbidden_terms.py dist",
    "test:calc": "node scripts/test_calculations.ts",
    "test:dom": "node scripts/test_dom.mjs",
    "test:pipeline": "python3 scripts/test_pipeline.py",
    "test": "npm run build && npm run test:calc && npm run test:dom && npm run guard && npm run test:samples && npm run test:pipeline && npm run test:queue",
    "collect": "python3 scripts/collect_topic.py",
    "generate": "python3 scripts/generate_guide.py",
    "sync:samples": "python3 scripts/sync_vault_samples.py --write",
    "test:samples": "python3 scripts/sync_vault_samples.py --check",
    "test:queue": "python3 scripts/test_queue.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20"
  }
}
